{
  "info": {
    "_postman_id": "a7e26c10-6c20-4b11-8e40-2373401012853",
    "name": "2373401012853_ChuThuanThanh_GoRest",
    "description": "GoRest API tests for Lab05. Run with users.csv and token environment variable.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Positive_Cases",
      "item": [
        {
          "name": "POST User",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const baseEmail = pm.iterationData.get('email') || pm.environment.get('email');",
                  "if (!baseEmail) { throw new Error('Missing email in users.csv or Environment'); }",
                  "const uniqueEmail = baseEmail.replace('@', `.${Date.now()}.${pm.info.iteration}@`);",
                  "pm.environment.set('uniqueEmail', uniqueEmail);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('User is created with status 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Response contains user ID', function () {",
                  "    const data = pm.response.json();",
                  "    pm.expect(data).to.have.property('id');",
                  "    pm.environment.set('userId', data.id);",
                  "});",
                  "pm.test('Response email matches unique email', function () {",
                  "    pm.expect(pm.response.json().email).to.eql(pm.environment.get('uniqueEmail'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{name}}\",\n  \"gender\": \"{{gender}}\",\n  \"email\": \"{{uniqueEmail}}\",\n  \"status\": \"{{status}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "https://gorest.co.in/public/v2/users"
          },
          "response": []
        },
        {
          "name": "POST User - Duplicate Email",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Duplicate email is rejected with status 422', function () {",
                  "    pm.response.to.have.status(422);",
                  "});",
                  "pm.test('Error response is returned', function () {",
                  "    pm.expect(pm.response.json()).to.be.an('array').that.is.not.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Duplicate Email Test\",\n  \"gender\": \"male\",\n  \"email\": \"{{uniqueEmail}}\",\n  \"status\": \"active\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "https://gorest.co.in/public/v2/users"
          },
          "response": []
        },
        {
          "name": "GET User",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Get user returns status 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Returned user ID matches created user', function () {",
                  "    pm.expect(String(pm.response.json().id)).to.eql(String(pm.environment.get('userId')));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "https://gorest.co.in/public/v2/users/{{userId}}"
          },
          "response": []
        },
